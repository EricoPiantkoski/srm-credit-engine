# JWT Secret (base64, >= 32 bytes)
JWT_SECRET=dGVzdC1zZWNyZXQtZm9yLWF1dG9tYXRlZC10ZXN0cy0wMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMA==

# Database (matches docker-compose.yml)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/srm_credit
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# JWT Config
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
JWT_ISSUER=SRM-CREDIT-ENGINE

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Rate Limiting
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL=PT1M

# Auth Rate Limiting
AUTH_RATE_LIMIT_CAPACITY=5
AUTH_RATE_LIMIT_REFILL=PT1M

# Pricing
PRECIFICACAO_TAXA_BASE=0.0

# External APIs
BCB_PTAX_BASE_URL=https://olinda.bcb.gov.br/olinda/servico/PTAX/versao/v1/odata
BCB_PTAX_TIMEOUT_MS=5000
BCB_PTAX_QUOTE_CURRENCY=USD
AWESOME_API_BASE_URL=https://economia.awesomeapi.com.br
AWESOME_API_TIMEOUT_MS=5000

# Security
SECURITY_EXPOSE_DOCS=true
SECURITY_CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none';

# Spring Profile
SPRING_PROFILES_ACTIVE=local

# Server
SERVER_PORT=8080