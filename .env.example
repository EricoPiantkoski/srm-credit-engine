# SRM Credit Engine - Environment Variables
# Copy to .env and fill in values
# All variables are required unless marked (optional)

# ===========================================
# DATABASE (PostgreSQL)
# ===========================================
POSTGRES_DB=srm_credit
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_secure_password

# ===========================================
# BACKEND (Spring Boot)
# ===========================================
# JWT - REQUIRED: secret MUST be >= 32 bytes (validated at startup)
JWT_SECRET=changeme_32_byte_minimum_secret_key_here
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
JWT_ISSUER=SRM-CREDIT-ENGINE

# CORS - comma-separated origins (no trailing slashes)
CORS_ALLOWED_ORIGINS=https://app.srmasset.com.br,https://homolog.srmasset.com.br

# Rate Limiting (Bucket4j)
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL=PT1M

# Precificação - taxa base mensal (assumida)
PRECIFICACAO_TAXA_BASE=0.0

# BCB PTAX Provider
BCB_PTAX_BASE_URL=https://olinda.bcb.gov.br/olinda/servico/PTAX/versao/v1/odata
BCB_PTAX_TIMEOUT_MS=5000
BCB_PTAX_QUOTE_CURRENCY=USD

# AwesomeAPI Provider (BRL-USD only)
AWESOME_API_BASE_URL=https://economia.awesomeapi.com.br
AWESOME_API_TIMEOUT_MS=5000

# Security
# SECURITY_EXPOSE_DOCS=true only for non-production
SECURITY_EXPOSE_DOCS=false
# CSP - adjust for your frontend domain if needed
SECURITY_CONTENT_SECURITY_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none';"

# ===========================================
# FRONTEND (React + Vite + Nginx)
# ===========================================
# Backend API URL (used by nginx proxy)
VITE_API_BASE_URL=http://backend:8080

# Sentry (optional - leave empty to disable)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production

# Sentry sourcemap upload (optional - requires SENTRY_AUTH_TOKEN, ORG, PROJECT)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ===========================================
# DOCKER IMAGES (for prod compose)
# ===========================================
BACKEND_IMAGE=ghcr.io/owner/repo-backend:latest
FRONTEND_IMAGE=ghcr.io/owner/repo-frontend:latest